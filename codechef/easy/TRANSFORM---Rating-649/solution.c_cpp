#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int X;
        cin >> X;

        if (X % 3 == 0)
            cout << "normal" << endl;
        else if (X % 3 == 1)
            cout << "huge" << endl;
        else
            cout << "small" << endl;
    }

    return 0;
}
