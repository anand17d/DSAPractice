#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int P, Q;
        cin >> P >> Q;

        int total = P + Q;

        if (total % 4 < 2)
            cout << "Alice" << endl;
        else
            cout << "Bob" << endl;
    }

    return 0;
}