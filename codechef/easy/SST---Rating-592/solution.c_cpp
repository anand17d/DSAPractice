#include <bits/stdc++.h>
using namespace std;

int main() {
	        int t;
	        cin>>t;
	        
	        while(t--){
	            int a,b;
	            
	            cin>>a>>b;
	            
	            int x = a*10;
	            int y = b*5;
	            
	            if(x>y){
	                cout<<"First"<<endl;
	            }
	            else if(x==y){
	                cout<<"any"<<endl;
	            }
	            else{
	                cout<<"Second"<<endl;
	            }
	        }

}
